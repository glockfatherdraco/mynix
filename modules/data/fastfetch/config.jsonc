{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}┌───────────── {#}{user-name-colored}{#1}@{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}System"
    },
    {
      "type": "os",
      "key": "{#1}│  {#keys}󰍹 OS          "
    },
    {
      "type": "kernel",
      "key": "{#1}│  {#keys}󰒋 Kernel      "
    },
    {
      "type": "uptime",
      "key": "{#1}│  {#keys}󰅐 Uptime      "
    },
    {
      "type": "packages",
      "key": "{#1}│  {#keys}󰏖 Packages    ",
      "format": "{all}"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Environment"
    },
    {
      "type": "de",
      "key": "{#1}│  {#keys}󰧨 DE          "
    },
    {
      "type": "wm",
      "key": "{#1}│  {#keys}󱂬 WM          "
    },
    {
      "type": "wmtheme",
      "key": "{#1}│  {#keys}󰉼 Theme       "
    },
    {
      "type": "display",
      "key": "{#1}│  {#keys}󰹑 Resolution  "
    },
    {
      "type": "shell",
      "key": "{#1}│  {#keys}󰞷 Shell       "
    },
    {
      "type": "terminal",
      "key": "{#1}│  {#keys}󰆍 Terminal    "
    },
    {
      "type": "terminalfont",
      "key": "{#1}│  {#keys}󰛖 Font        "
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "custom",
      "format": "{#1}│ {#}Hardware"
    },
    {
      "type": "cpu",
      "key": "{#1}│  {#keys}󰻠 CPU         "
    },
    {
      "type": "gpu",
      "key": "{#1}│  {#keys}󰢮 GPU         "
    },
    {
      "type": "memory",
      "key": "{#1}│  {#keys}󰍛 Memory      "
    },
    {
      "type": "disk",
      "key": "{#1}│  {#keys}󰋊 Disk (/)    ",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    {
      "type": "colors",
      "key": "{#1}│             ",
      "symbol": "diamond"
    },
    {
      "type": "custom",
      "format": "{#1}└───────────────────────────────┘"
    }
  ]
}
